foreach(variable IN ITEMS SHADOW_HEADER_TEST_ROOT SHADOW_HEADER_SYNC_SCRIPT)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "missing ${variable}")
    endif()
endforeach()
set(cargo_root "${SHADOW_HEADER_TEST_ROOT}/cargo")
set(record "${cargo_root}/out-dir.txt")
set(include_root "${SHADOW_HEADER_TEST_ROOT}/include")
foreach(identity IN ITEMS stale current)
    set(out "${cargo_root}/debug/build/shadow-desktop-bridge-${identity}/out")
    file(MAKE_DIRECTORY "${out}/cxxbridge/include/shadow-desktop-bridge/src")
    file(WRITE "${out}/cxxbridge/include/shadow-desktop-bridge/src/lib.rs.h" "${identity}")
endforeach()
set(current_out "${cargo_root}/debug/build/shadow-desktop-bridge-current/out")
file(WRITE "${record}" "${current_out}\n")
function(sync_headers record_path should_pass)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSHADOW_CARGO_TARGET_DIRECTORY=${cargo_root}" -DSHADOW_CARGO_PROFILE=debug
        "-DSHADOW_CXXBRIDGE_INCLUDE_DIRECTORY=${include_root}"
        "-DSHADOW_CXXBRIDGE_OUT_DIR_RECORD=${record_path}"
        -P "${SHADOW_HEADER_SYNC_SCRIPT}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
    if((should_pass AND NOT result EQUAL 0) OR (NOT should_pass AND result EQUAL 0))
        message(FATAL_ERROR "unexpected sync result: ${result}: ${output} ${diagnostic}")
    endif()
endfunction()
sync_headers("${record}" TRUE)
file(READ "${include_root}/shadow-desktop-bridge/src/lib.rs.h" header)
if(NOT header STREQUAL "current")
    message(FATAL_ERROR "selected a stale ABI header")
endif()
file(WRITE "${record}" "${SHADOW_HEADER_TEST_ROOT}/unrelated/out\n")
sync_headers("${record}" FALSE)
file(WRITE "${record}" "${cargo_root}/debug/build/shadow-desktop-bridge-missing/out\n")
sync_headers("${record}" FALSE)
sync_headers("${cargo_root}/missing-record.txt" FALSE)
# A legacy caller without a record must continue to reject ambiguous output.
sync_headers("" FALSE)
file(READ "${include_root}/shadow-desktop-bridge/src/lib.rs.h" preserved_header)
if(NOT preserved_header STREQUAL "current")
    message(FATAL_ERROR "failed sync changed the current ABI header")
endif()
message(STATUS "Cargo header identity: current artifact selected; stale/invalid records rejected")
