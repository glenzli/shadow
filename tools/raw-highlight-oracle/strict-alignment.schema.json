{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadow.local/schemas/raw-highlight-strict-alignment-20260920.1.json",
  "title": "Shadow RAW highlight strict alignment receipt",
  "type": "object",
  "required": [
    "schema",
    "version",
    "created_utc",
    "fixtures",
    "aggregate",
    "method"
  ],
  "properties": {
    "schema": {
      "const": "shadow.raw-highlight-strict-alignment.20260920.1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "fixture_count",
        "maximum_candidate_count_relative_delta",
        "maximum_write_count_relative_delta",
        "maximum_linear_absolute_difference"
      ],
      "properties": {
        "fixture_count": { "type": "integer", "minimum": 1 },
        "maximum_candidate_count_relative_delta": { "$ref": "#/$defs/relativeDelta" },
        "maximum_write_count_relative_delta": { "$ref": "#/$defs/relativeDelta" },
        "maximum_linear_absolute_difference": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "comparison",
        "input_boundary",
        "counts",
        "threshold_hypothesis",
        "linear_output",
        "admission"
      ],
      "properties": {
        "comparison": { "type": "string", "minLength": 1 },
        "input_boundary": { "const": "same provider-neutral RawFrame" },
        "counts": { "type": "string", "minLength": 1 },
        "threshold_hypothesis": { "type": "string", "minLength": 1 },
        "linear_output": { "const": "shared Shadow area sampling and camera matrix" },
        "admission": { "const": "diagnostic evidence only" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "required": ["basename", "size_bytes", "sha256"],
      "properties": {
        "basename": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "probeIdentity": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": { "const": "shadow-raw-probe" },
        "resolved_path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "relativeDelta": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "countAlignment": {
      "enum": [
        "exact-count",
        "close-count",
        "divergent-count",
        "reference-zero-shadow-positive"
      ]
    },
    "referenceChannel": {
      "type": "object",
      "required": [
        "effective_white_balance_gain",
        "clip_value",
        "clipped_photosites",
        "changed_photosites",
        "chrominance_offset"
      ],
      "properties": {
        "effective_white_balance_gain": { "type": "number" },
        "clip_value": { "type": "number" },
        "clipped_photosites": { "type": "integer", "minimum": 0 },
        "changed_photosites": { "type": "integer", "minimum": 0 },
        "chrominance_offset": { "type": "number" }
      },
      "additionalProperties": false
    },
    "shadowChannel": {
      "type": "object",
      "required": [
        "terminal_candidates",
        "raised_photosites",
        "compiled_chrominance_offset"
      ],
      "properties": {
        "terminal_candidates": { "type": "integer", "minimum": 0 },
        "raised_photosites": { "type": "integer", "minimum": 0 },
        "compiled_chrominance_offset": { "type": "number" }
      },
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "required": [
        "channel",
        "reference",
        "shadow",
        "candidate_count_delta",
        "candidate_count_relative_delta",
        "candidate_count_alignment",
        "write_count_delta",
        "write_count_relative_delta",
        "write_count_alignment",
        "chrominance_offset_delta"
      ],
      "properties": {
        "channel": { "enum": ["R", "G", "B"] },
        "reference": { "$ref": "#/$defs/referenceChannel" },
        "shadow": { "$ref": "#/$defs/shadowChannel" },
        "candidate_count_delta": { "type": "integer" },
        "candidate_count_relative_delta": { "$ref": "#/$defs/relativeDelta" },
        "candidate_count_alignment": { "$ref": "#/$defs/countAlignment" },
        "write_count_delta": { "type": "integer" },
        "write_count_relative_delta": { "$ref": "#/$defs/relativeDelta" },
        "write_count_alignment": { "$ref": "#/$defs/countAlignment" },
        "chrominance_offset_delta": { "type": "number" }
      },
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "required": [
        "reference_clipped_photosites",
        "reference_changed_photosites",
        "shadow_terminal_candidates",
        "shadow_raised_photosites",
        "candidate_count_relative_delta",
        "candidate_count_alignment",
        "write_count_relative_delta",
        "write_count_alignment"
      ],
      "properties": {
        "reference_clipped_photosites": { "type": "integer", "minimum": 0 },
        "reference_changed_photosites": { "type": "integer", "minimum": 0 },
        "shadow_terminal_candidates": { "type": "integer", "minimum": 0 },
        "shadow_raised_photosites": { "type": "integer", "minimum": 0 },
        "candidate_count_relative_delta": { "$ref": "#/$defs/relativeDelta" },
        "candidate_count_alignment": { "$ref": "#/$defs/countAlignment" },
        "write_count_relative_delta": { "$ref": "#/$defs/relativeDelta" },
        "write_count_alignment": { "$ref": "#/$defs/countAlignment" }
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "required": ["value", "domain"],
      "properties": {
        "value": { "type": "number" },
        "domain": { "enum": ["physical-white", "linear-response-limit"] }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "id",
        "manifest",
        "source",
        "orchestrator_version",
        "probe",
        "channels",
        "totals",
        "linear_output",
        "thresholds",
        "elapsed_ms",
        "interpretation_boundary"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "manifest": { "$ref": "#/$defs/fileIdentity" },
        "source": { "$ref": "#/$defs/fileIdentity" },
        "orchestrator_version": { "type": "string", "minLength": 1 },
        "probe": { "$ref": "#/$defs/probeIdentity" },
        "channels": {
          "type": "array",
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/channel" }, { "properties": { "channel": { "const": "R" } } }] },
            { "allOf": [{ "$ref": "#/$defs/channel" }, { "properties": { "channel": { "const": "G" } } }] },
            { "allOf": [{ "$ref": "#/$defs/channel" }, { "properties": { "channel": { "const": "B" } } }] }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "totals": { "$ref": "#/$defs/totals" },
        "linear_output": {
          "type": "object",
          "required": [
            "dimensions",
            "mean_absolute_difference",
            "maximum_absolute_difference",
            "strongest_boundary_difference"
          ],
          "properties": {
            "dimensions": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" },
            "mean_absolute_difference": { "type": "number", "minimum": 0 },
            "maximum_absolute_difference": { "type": "number", "minimum": 0 },
            "strongest_boundary_difference": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "thresholds": {
          "type": "object",
          "required": [
            "shadow",
            "reference",
            "cfa_white_levels",
            "has_linear_response_limits",
            "cfa_linear_response_limits"
          ],
          "properties": {
            "shadow": { "$ref": "#/$defs/threshold" },
            "reference": { "$ref": "#/$defs/threshold" },
            "cfa_white_levels": { "type": "string", "minLength": 1 },
            "has_linear_response_limits": { "enum": ["yes", "no"] },
            "cfa_linear_response_limits": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "elapsed_ms": { "type": "number", "minimum": 0 },
        "interpretation_boundary": {
          "type": "object",
          "required": [
            "count_comparison_is_spatial_overlap",
            "same_rawframe",
            "shared_downstream",
            "quality_ranking"
          ],
          "properties": {
            "count_comparison_is_spatial_overlap": { "const": false },
            "same_rawframe": { "const": true },
            "shared_downstream": { "const": "shadow-area-sampling-and-camera-matrix" },
            "quality_ranking": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
